{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlexaPlusEcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AlexaPlusEcrRepo",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:*:*:repository/alexa-plus-server"
    },
    {
      "Sid": "AlexaPlusAppRunnerList",
      "Effect": "Allow",
      "Action": "apprunner:ListServices",
      "Resource": "*"
    },
    {
      "Sid": "AlexaPlusAppRunnerService",
      "Effect": "Allow",
      "Action": [
        "apprunner:CreateService",
        "apprunner:UpdateService",
        "apprunner:DescribeService"
      ],
      "Resource": "arn:aws:apprunner:*:*:service/alexa-plus-mcp-server/*"
    },
    {
      "Sid": "AlexaPlusAccessRole",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:AttachRolePolicy"],
      "Resource": "arn:aws:iam::*:role/alexa-plus-apprunner-ecr-access"
    },
    {
      "Sid": "AlexaPlusPassAccessRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/alexa-plus-apprunner-ecr-access",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "build.apprunner.amazonaws.com"}
      }
    },
    {
      "Sid": "AlexaPlusCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
